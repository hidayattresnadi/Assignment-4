        /* Sidebar */
        .sidebar {
            width: 250px;
            max-width: 100%;
            height: 100vh;
            background: #343a40;
            color: white;
            position: fixed;
            left: -250px;
            top: 0;
            transition: all 0.3s ease;
            padding: 15px;
        }

        .sidebar.show {
            left: 0;
        }

        /* Responsive sidebar */
        @media (max-width: 768px) {
            .sidebar {
                width: 60%;
                left: -60%;
            }

            .sidebar.show {
                left: 0;
            }
        }

        /* Navbar & content shift */
        .content {
            transition: margin-left 0.3s ease;
            margin-left: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .content.shifted {
            margin-left: 250px;
        }

        @media (max-width: 768px) {
            .content.shifted {
                margin-left: 60%;
            }
        }

        /* Sticky footer */
        .footer {
            background: #343a40;
            color: white;
            text-align: center;
            padding: 10px;
            margin-top: auto;
        }
    </style>
</head>

